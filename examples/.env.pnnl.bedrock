# Example: PNNL gateway for completion + AWS Bedrock for embeddings.
#
# Mirror of .env.bedrock.pnnl — use this when you want PNNL's gateway
# for chat (works for all five agents including codex) but Bedrock
# Titan v2 (1024-dim) for embeddings instead of PNNL's
# text-embedding-3-small (1536-dim).  Switching the embedder later
# strands prior collections at the old dimension; rebuild on switch.

# --- Upstream LLM gateway: PNNL ai-incubator-api ---
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://ai-incubator-api.pnnl.gov
LLM_MODEL=claude-sonnet-4-5-20250929-v1-project

# --- Embedding endpoint: AWS Bedrock native InvokeModel ---
EMBEDDING_PROVIDER=bedrock
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://bedrock-runtime.us-east-2.amazonaws.com
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
