# Example: Anthropic API for completion + OpenAI API for embeddings.
#
# Anthropic doesn't offer an embeddings endpoint, so embeddings need a
# separate provider.  This example uses OpenAI directly; substitute Voyage,
# Cohere, or any OpenAI-wire-compatible gateway as needed.
#
# !! Do NOT include /v1 in LLM_BASE_URL.  LiteLLM's Anthropic adapter
# auto-appends /v1/messages and only checks for that exact suffix — a
# trailing /v1 produces /v1/v1/messages and 404s.  Use the bare host.

# --- Upstream LLM gateway: Anthropic API ---
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_BASE_URL=https://api.anthropic.com
LLM_MODEL=claude-sonnet-4-5-20250929

# --- Embedding endpoint: OpenAI API ---
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
