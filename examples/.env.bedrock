# Example: AWS Bedrock for both completion and embeddings.
#
# Bearer-token API keys for Bedrock have a 12-hour expiry — regenerate
# from the AWS console and paste here when expired.  Anthropic models
# require a cross-region inference profile id (the ``us.`` prefix); the
# bare model id returns "on-demand throughput isn't supported".
#
# Codex is NOT supported with Bedrock — it wraps MCP tools in a non-
# standard schema that Bedrock's Anthropic Messages adapter can't unpack.
# Use claude-code, goose, cline, or roo for Bedrock setups.

# --- Upstream LLM gateway ---
LLM_PROVIDER=bedrock
LLM_API_KEY=
LLM_BASE_URL=https://bedrock-runtime.us-east-2.amazonaws.com
LLM_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0

# --- Embedding endpoint (Titan via native Bedrock InvokeModel) ---
EMBEDDING_PROVIDER=bedrock
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://bedrock-runtime.us-east-2.amazonaws.com
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
