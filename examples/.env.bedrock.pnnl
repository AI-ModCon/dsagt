# Example: AWS Bedrock for completion + PNNL gateway for embeddings.
#
# Use this when you have AWS Bedrock access for chat (frontier Claude
# models) but want to avoid the Bedrock embeddings setup, or your account
# doesn't have Titan/Cohere embedding model access enabled.  Each
# collection's route.json pins the embedder used at ingest time, so this
# pairing stays consistent across sessions as long as .env doesn't switch.
#
# Codex is NOT supported with Bedrock — see .env.bedrock for details.

# --- Upstream LLM gateway: AWS Bedrock ---
LLM_PROVIDER=bedrock
LLM_API_KEY=
LLM_BASE_URL=https://bedrock-runtime.us-east-2.amazonaws.com
LLM_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0

# --- Embedding endpoint: PNNL ai-incubator-api ---
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://ai-incubator-api.pnnl.gov
EMBEDDING_MODEL=text-embedding-3-small-project
