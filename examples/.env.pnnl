# Example: PNNL ai-incubator-api gateway for both completion and embeddings.
#
# The gateway speaks OpenAI's chat/completions and embeddings wire formats.
# Model names are the gateway's project-suffixed aliases (claude-... -v1-project,
# text-embedding-3-small-project) — they map to the underlying providers
# server-side.  All five DSAGT agents (claude-code, goose, cline, roo, codex)
# work against this configuration.

# --- Upstream LLM gateway ---
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://ai-incubator-api.pnnl.gov
LLM_MODEL=claude-sonnet-4-5-20250929-v1-project

# --- Embedding endpoint (same gateway as LLM) ---
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://ai-incubator-api.pnnl.gov
EMBEDDING_MODEL=text-embedding-3-small-project
